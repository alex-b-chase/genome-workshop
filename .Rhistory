setwd("/Volumes/OfficeSMU/Teaching/SMU/microdiversity/genome-workshop")
DATA_DIR <- "data"
if (!dir.exists(DATA_DIR)) {
stop(
"Could not find the data/ directory. ",
"Set your working directory to the root of the genome-workshop repository."
)
}
library(ggplot2)
genome_stats <- read.delim(
file.path(DATA_DIR, "stats", "genome_stats.tsv"),
check.names = FALSE
)
genome_stats
names(genome_stats)
ani <- read.delim(
file.path(DATA_DIR, "ani", "all_vs_all.fastani.tsv"),
header = FALSE,
sep = "\t"
)
names(ani) <- c(
"query",
"reference",
"ANI",
"mapped_fragments",
"total_fragments"
)
clean_name <- function(x) {
x <- basename(x)
sub(
"\\.(fasta|fa|fna)$",
"",
x
)
}
ani$query <- clean_name(ani$query)
ani$reference <- clean_name(ani$reference)
head(ani)
ani$mapped_fraction <-
ani$mapped_fragments /
ani$total_fragments
head(ani)
genomes <- sort(
unique(
c(
ani$query,
ani$reference
)
)
)
ANI <- matrix(
NA_real_,
nrow = length(genomes),
ncol = length(genomes),
dimnames = list(genomes, genomes)
)
diag(ANI) <- 100
for (i in seq_along(genomes)) {
for (j in seq_along(genomes)) {
g1 <- genomes[i]
g2 <- genomes[j]
values <- ani$ANI[
(ani$query == g1 & ani$reference == g2) |
(ani$query == g2 & ani$reference == g1)
]
if (length(values) > 0) {
ANI[i, j] <- mean(
values,
na.rm = TRUE
)
}
}
}
round(ANI, 2)
if (!anyNA(ANI)) {
ani_tree <- hclust(
as.dist(100 - ANI)
)
genome_order <-
ani_tree$labels[
ani_tree$order
]
} else {
# FastANI may not report very divergent genome pairs.
#
# If that occurs, retain the original genome order.
genome_order <- genomes
message(
"Missing ANI values detected; ",
"using genome input order."
)
}
genome_order
ani_plot <- as.data.frame(
as.table(ANI)
)
names(ani_plot) <- c(
"Genome1",
"Genome2",
"ANI"
)
ani_plot$Genome1 <- factor(
ani_plot$Genome1,
levels = rev(genome_order)
)
ani_plot$Genome2 <- factor(
ani_plot$Genome2,
levels = genome_order
)
ggplot(
ani_plot,
aes(
x = Genome2,
y = Genome1,
fill = ANI
)
) +
geom_tile() +
geom_text(
aes(
label = round(ANI, 1)
),
size = 4
) +
coord_equal() +
labs(
x = NULL,
y = NULL,
fill = "ANI (%)"
) +
theme_classic() +
theme(
axis.text.x = element_text(
angle = 45,
hjust = 1
)
)
pan70 <- read.delim(
file.path(DATA_DIR, "panaroo", "family_70", "gene_presence_absence.Rtab"),
check.names = FALSE
)
head(pan70)
gene_family <- pan70[[1]]
PANGENOME <- as.matrix(
pan70[, -1]
)
rownames(PANGENOME) <- gene_family
storage.mode(PANGENOME) <- "numeric"
dim(PANGENOME)
head(PANGENOME)
colnames(PANGENOME)
frequency <- rowSums(
PANGENOME > 0
)
table(frequency)
N <- ncol(PANGENOME)
gene_class <- ifelse(
frequency == N,
"Core",
ifelse(
frequency == 1,
"Unique",
"Shared flexible"
)
)
table(gene_class)
thresholds <- c(
50,
60,
70,
80,
90,
95
)
threshold_results <- data.frame()
for (threshold in thresholds) {
file <- file.path(
DATA_DIR,
"panaroo",
paste0("family_", threshold),
"gene_presence_absence.Rtab"
)
dat <- read.delim(
file,
check.names = FALSE
)
PA <- as.matrix(
dat[, -1]
)
storage.mode(PA) <- "numeric"
N <- ncol(PA)
frequency <- rowSums(
PA > 0
)
# Pangenome:
# every gene family detected in at least one genome.
pan_size <- sum(
frequency > 0
)
# Core:
# gene families found in every genome.
core_size <- sum(
frequency == N
)
flexible_size <-
pan_size -
core_size
threshold_results <- rbind(
threshold_results,
data.frame(
Threshold = threshold,
Core = core_size,
Flexible = flexible_size,
Pangenome = pan_size
)
)
}
threshold_results
threshold_long <- rbind(
data.frame(
Threshold = threshold_results$Threshold,
Gene_families = threshold_results$Core,
Genome_component = "Core genome"
),
data.frame(
Threshold = threshold_results$Threshold,
Gene_families = threshold_results$Pangenome,
Genome_component = "Pangenome"
)
)
ggplot(
threshold_long,
aes(
x = Threshold,
y = Gene_families,
linetype = Genome_component
)
) +
geom_line(
linewidth = 1
) +
geom_point(
size = 3
) +
scale_x_continuous(
breaks = thresholds
) +
labs(
x = "Minimum protein family identity (%)",
y = "Number of gene families",
linetype = NULL
) +
theme_classic()
FOCAL <- "Curtobacterium_grass058"
other_genomes <- setdiff(
genomes,
FOCAL
)
other_genomes <- other_genomes[
order(
ANI[
FOCAL,
other_genomes
],
decreasing = TRUE,
na.last = TRUE
)
]
comparison_order <- c(
FOCAL,
other_genomes
)
other_genomes <- other_genomes[
order(
ANI[
FOCAL,
other_genomes
],
decreasing = TRUE,
na.last = TRUE
)
]
FOCAL <- "MCLR17_059"
other_genomes <- setdiff(
genomes,
FOCAL
)
other_genomes <- other_genomes[
order(
ANI[
FOCAL,
other_genomes
],
decreasing = TRUE,
na.last = TRUE
)
]
comparison_order <- c(
FOCAL,
other_genomes
)
comparison_order
colnames(PANGENOME)
comparison_order
growth <- data.frame()
for (k in seq_along(comparison_order)) {
genomes_now <-
comparison_order[1:k]
subset_matrix <- PANGENOME[
,
genomes_now,
drop = FALSE
]
frequency <- rowSums(
subset_matrix > 0
)
# Present in at least one genome.
pan_size <- sum(
frequency > 0
)
# Present in every genome included so far.
core_size <- sum(
frequency == k
)
growth <- rbind(
growth,
data.frame(
Number_genomes = k,
Added_genome = genomes_now[k],
Core = core_size,
Pangenome = pan_size
)
)
}
growth
growth_long <- rbind(
data.frame(
Number_genomes = growth$Number_genomes,
Gene_families = growth$Core,
Genome_component = "Core genome"
),
data.frame(
Number_genomes = growth$Number_genomes,
Gene_families = growth$Pangenome,
Genome_component = "Pangenome"
)
)
ggplot(
growth_long,
aes(
x = Number_genomes,
y = Gene_families,
linetype = Genome_component
)
) +
geom_line(
linewidth = 1
) +
geom_point(
size = 3
) +
scale_x_continuous(
breaks = 1:5
) +
labs(
x = "Number of genomes included",
y = "Number of gene families",
linetype = NULL
) +
theme_classic()
frequency_table <- as.data.frame(
table(
rowSums(PANGENOME > 0)
)
)
names(frequency_table) <- c(
"Number_genomes",
"Gene_families"
)
frequency_table$Number_genomes <-
as.numeric(
as.character(
frequency_table$Number_genomes
)
)
ggplot(
frequency_table,
aes(
x = Number_genomes,
y = Gene_families
)
) +
geom_col() +
scale_x_continuous(
breaks = 1:5
) +
labs(
x = "Number of genomes containing gene family",
y = "Number of gene families"
) +
theme_classic()
